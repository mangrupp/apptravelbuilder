# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/travelbudget?schema=public"

# NextAuth
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Set to "true" when running behind a reverse proxy / in a container where the
# incoming Host header may not match NEXTAUTH_URL.
AUTH_TRUST_HOST="true"

# AI (OpenAI-compatible API - OpenAI, Azure OpenAI, OpenRouter, etc.)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
